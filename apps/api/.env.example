# apps/api — variables de entorno (ver apps/api/src/env.ts). Copiar a `.env`
# (excluido de git) y ajustar. Ninguno de los valores de abajo es un secreto real.
#
# Rotación de secretos: ver docs/runbooks/operacion.md §6.

# development | test | production — en production, JWT_SECRET y
# CORS_ALLOWED_ORIGINS son obligatorios (sin default silencioso, REQ-SEG-013).
NODE_ENV=development

PORT=3001

# Firma de access/refresh tokens (jose/HS256). Generar con: openssl rand -base64 48
# Fuera de producción, si se omite, cae a un valor de desarrollo documentado como
# inseguro (nunca usarlo contra datos reales).
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Lista de orígenes permitidos por CORS, separados por coma. NUNCA "*"
# (auditoria-1/seguridad.md [MEDIO]). Fuera de producción, si se omite, cae a
# http://localhost:5173 (vite dev) y http://localhost:4173 (vite preview).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# embedded-postgres local (ADR-003) — no aplica a producción (Supabase). Déjalo SIN
# DEFINIR: apps/api/src/env.ts ya calcula un default absoluto anclado a la raíz del
# repo (packages/db/.pgdata), la MISMA carpeta que usan packages/db/src/cli.ts y
# scripts/backup.ts/restore.ts. auditoria-2/operabilidad [ALTO]: si defines aquí una
# ruta RELATIVA como "packages/db/.pgdata", vuelve a depender del cwd del proceso --
# con `npm run dev --workspace=@atiende-hoteles/api` (cwd real: apps/api/) escribiría
# en `apps/api/packages/db/.pgdata/`, fuera de `.gitignore` y de la vista de
# scripts/backup.sh (que resuelve la MISMA cadena relativa contra la raíz del repo, un
# directorio distinto). Si necesitas cambiar la ubicación, usa una ruta ABSOLUTA.
# DB_DATA_DIR=
DB_PORT=54329

# Rate limit (ipRateLimit/userRateLimit, apps/api/src/middleware.ts).
RATE_LIMIT_PER_IP_PER_MINUTE=300
RATE_LIMIT_PER_USER_PER_MINUTE=600

# Logging (apps/api/src/logger.ts). LOG_PRETTY=1 SOLO en desarrollo interactivo
# (nunca en producción: ahí siempre JSON por línea).
LOG_LEVEL=info
LOG_PRETTY=0

# Opcional: si se define, /metrics exige la cabecera X-Metrics-Token con este
# mismo valor (401 si falta/no coincide). Sin definir, /metrics queda abierto
# (pensado para exponerse solo dentro de la red del scraper de métricas).
METRICS_TOKEN=

# auditoria-2/operabilidad [ALTO]: destino de la alerta del camino del dinero
# (src/lib/moneyAlert.ts). Sin ninguna de las dos, la alerta queda SOLO como línea de
# log (el proceso lo declara al arrancar y GET /ready lo refleja en
# moneyAlertsConfigured: false).
# Webhook genérico (Slack Incoming Webhook, PagerDuty Events API, endpoint propio, o un
# relevo webhook->correo): recibe el JSON completo de la alerta por HTTP POST.
MONEY_ALERT_WEBHOOK_URL=
# Alternativa/adicional: requiere AMBAS variables. Envía {to, subject, alert} a
# MONEY_ALERT_EMAIL_WEBHOOK_URL -- este repo no trae ningún cliente SMTP/proveedor de
# correo propio (ADR-007, sin credenciales reales); MONEY_ALERT_EMAIL_WEBHOOK_URL debe
# apuntar a un relevo que sepa convertir ese payload en un correo real.
MONEY_ALERT_EMAIL_TO=
MONEY_ALERT_EMAIL_WEBHOOK_URL=

# Producción (Supabase, ADR-003) — consumido por apps/api/src/dbProduction.ts
# (openManagedPostgres): si AMBAS están definidas, apps/api se conecta a este
# Postgres gestionado en vez de arrancar embedded-postgres (H12b, ver
# docs/runbooks/migracion-a-supabase.md y deploy/env-matrix.md). Obligatorias
# cuando NODE_ENV=production — el arranque falla explícito si faltan.
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# Contraseña REAL del rol atiende_app (fijada con ALTER ROLE tras `supabase db
# push`, nunca el placeholder de packages/db/migrations/0001 transformado) —
# NUNCA una credencial de superusuario (ver deploy/README.md "Por qué `admin`
# de producción no es superusuario").
# SUPABASE_DB_PASSWORD_APP=

# ---------------------------------------------------------------------------
# H12a · Google OAuth (routes/auth-google.ts) — REQUISITOS.md REQ-LAUNCH-001/003.
# Sin las 3 primeras, el botón "Continuar con Google" del panel se declara
# honestamente deshabilitado y GET /auth/google/iniciar|callback responden 503
# `no_configurado` — nunca se simula el flujo sin credenciales reales.
#
# Cómo obtenerlas (Google Cloud Console, console.cloud.google.com):
#   1. Crea (o reutiliza) un proyecto → "APIs y servicios" → "Pantalla de
#      consentimiento de OAuth" → tipo "Externo", agrega el dominio del panel.
#   2. "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth" →
#      tipo "Aplicación web".
#   3. "URIs de redirección autorizados": agrega EXACTAMENTE
#      https://<tu-dominio-de-apps-api>/auth/google/callback (debe coincidir
#      byte a byte con GOOGLE_REDIRECT_URI de abajo — Google rechaza cualquier
#      diferencia, incluida una barra final de más).
#   4. "Orígenes de JavaScript autorizados": el dominio del PANEL (apps/web),
#      no el de la API (no se usa OAuth implícito del lado del cliente).
#   5. Copia "ID de cliente" y "Secreto del cliente" abajo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Endpoints reales de Google — normalmente NUNCA se tocan (los defaults ya son
# los correctos). Solo se sobreescriben en pruebas, para apuntar al servidor
# OAuth FALSO local (tests/support/fakeGoogleOAuth.ts).
# GOOGLE_OAUTH_BASE_URL=https://accounts.google.com
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_ISSUER=https://accounts.google.com

# H12a · URL pública del panel (apps/web) — a donde se redirige tras un login/alta
# por Google y la base de los enlaces de los correos transaccionales
# (verificación, invitación, restablecer contraseña, cambio de correo).
FRONTEND_URL=http://localhost:5173

# H12a · límite de tasa dedicado de POST /registro (más estricto que el general
# por IP: crea filas reales de org/hotel/staff_user, no solo lee datos).
RATE_LIMIT_REGISTRO_POR_IP_POR_HORA=5

# ---------------------------------------------------------------------------
# H12a · packages/email — REQ-LAUNCH-010. Sin NINGUNA de las dos secciones de
# abajo configuradas, `createApp()` usa `FakeEmailAdapter` (persiste en
# `email_outbox`, nunca llama a un proveedor real) — ver packages/email/README.md
# para el detalle completo y `npm run email:preview` para ver las 12 plantillas.
#
# PENDIENTE-COORDINACIÓN: estas variables ya las leen `ResendAdapter`/`SmtpAdapter`
# (packages/email) en cuanto algo los instancia, pero `apps/api/src/server.ts`
# (fuera del alcance de este agente) todavía NO construye un `EmailPort` real a
# partir de ellas para pasarlo a `AppDeps.emailPort` -- hasta que se agregue esa
# línea ahí (mismo patrón que `payments`/`cfdi` en app.ts), definir estas
# variables en producción NO activa el envío real desde las rutas de
# registro/correo (sí lo activa para el worker standalone,
# apps/api/src/emailOutbox/runEmailOutboxWorker.ts, que resuelve el adaptador él
# mismo).

# Opción A: Resend (https://resend.com) — recomendado, sin SMTP que mantener.
#   1. Crea una cuenta y un dominio en resend.com/domains.
#   2. Agrega los registros DNS que Resend te da (SPF/DKIM) en tu proveedor de
#      DNS y espera a que el dominio quede "Verified" (puede tardar hasta 48h).
#   3. "API Keys" → crea una con permiso de envío → cópiala abajo.
#   4. RESEND_FROM_EMAIL debe ser una dirección de ESE dominio verificado
#      (ej. reservas@tu-hotel-o-marca.com) — Resend rechaza remitentes de un
#      dominio no verificado.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Opción B: SMTP genérico (Amazon SES, SendGrid, Mailgun, tu propio servidor).
# Usa SOLO una de las dos opciones (si ambas están configuradas, Resend gana).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------------------------------------------------------------------------
# H15-007 · packages/mcp-servers/payments — REQ-INT-002. Sin NINGUNA de las dos
# secciones de abajo configuradas, `resolvePaymentPort()` (apps/api/src/lib/
# resolvePaymentPort.ts) usa `FakeStripeAdapter` (simulado, nunca cobra de verdad)
# — ver packages/mcp-servers/payments/README.md para el detalle completo,
# incluida la sección "Credenciales necesarias para la primera prueba real".
#
# [PENDIENTE DE VERIFICACIÓN CONTRA EL PROVEEDOR REAL]: los adaptadores hacen
# llamadas HTTP reales y se probaron contra un simulador local de contrato, pero
# NUNCA se ejecutó una llamada real contra Stripe/Conekta en esta sesión — no
# asumas que "probablemente funciona" solo por definir estas variables.

# Opción A: Stripe (https://dashboard.stripe.com) — tiene prioridad si ambas
# secciones están configuradas (mismo criterio Resend>SMTP de arriba).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Opción B: Conekta (https://panel.conekta.com).
# CONEKTA_PRIVATE_KEY=
# CONEKTA_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# H15-012 · packages/mcp-servers/whatsapp — WhatsApp Cloud API (Meta), REQ-INT-003.
# [PENDIENTE DE CREDENCIALES / NO VERIFICADO CONTRA META REAL] -- sin las 3 variables de
# abajo, `apps/api/src/lib/messaging.ts` usa `FakeWhatsappAdapter` (simulado, nunca llama
# a graph.facebook.com); con las 3 presentes, usa `MetaWhatsappAdapter` real (mismo
# patrón que Resend/SMTP arriba). Ver packages/mcp-servers/whatsapp/README.md
# §"Primera prueba real" para el detalle completo de estos pasos.
#
#   1. Crea una app en https://developers.facebook.com/apps (tipo "Business") y agrégale
#      el producto "WhatsApp".
#   2. En WhatsApp → Configuración de la API: copia el "Token de acceso temporal" (para
#      producción, genera uno permanente vía un Usuario del Sistema con el rol
#      `whatsapp_business_messaging`) → WHATSAPP_ACCESS_TOKEN.
#   3. En esa misma pantalla, copia el "ID del número de teléfono" (el de PRUEBA de Meta
#      sirve para probar; para producción, verifica tu propio número de WhatsApp Business)
#      → WHATSAPP_PHONE_NUMBER_ID.
#   4. En Configuración de la app → Básico: copia el "Secreto de la app" (App Secret) →
#      WHATSAPP_APP_SECRET (firma HMAC-SHA256 de cada webhook entrante,
#      `X-Hub-Signature-256` -- NUNCA el `webhook_secret` por hotel de
#      `hotel_messaging_config`, que solo aplica al adaptador simulado).
#   5. En WhatsApp → Configuración → Webhooks: registra la URL pública de
#      `POST/GET {FRONTEND_URL o dominio de la API}/hoteles/:hotelId/mensajeria/webhook`
#      y un "Token de verificación" elegido por ti → WHATSAPP_WEBHOOK_VERIFY_TOKEN (Meta
#      manda un GET con ese token antes de activar el webhook; sin esta variable, ese GET
#      se rechaza siempre). Suscríbete al campo `messages`.
#   6. Envía un mensaje de prueba real desde el número de prueba de Meta al tuyo, y
#      verifica que este backend lo reciba y responda (disclosure de IA, REQ-HUE-006).
#
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# REQ-SEG-013 (GOB-041) — provider de secretos, ver apps/api/src/lib/secretsProvider.ts.
# Opcional/opt-in: sin SECRETS_BACKEND (o con SECRETS_BACKEND=env), el arranque es
# EXACTAMENTE el de siempre -- lee las variables de arriba directo de process.env, 0
# llamadas de red. SECRETS_BACKEND=vault activa una capa REAL (protocolo HTTP genuino
# de HashiCorp Vault KV v2) que, ANTES de leer cualquier variable de arriba, lee un
# secreto de Vault y copia sus claves a process.env (sobrescribiendo cualquier valor
# plano ya definido). Fail-closed: si declaras SECRETS_BACKEND=vault y falta
# VAULT_ADDR/VAULT_TOKEN/VAULT_SECRET_PATH, o Vault no responde, el arranque FALLA --
# nunca sigue en silencio con las variables de entorno planas.
#
# ADVERTENCIA HONESTA: este repo nunca ha tenido una instancia de Vault/KMS
# desplegada ni credenciales de ese servicio -- este cliente implementa el protocolo
# real pero NUNCA se ha probado de extremo a extremo contra un Vault real (solo
# contra un `fetch` sustituido en tests/unit/api/secrets-provider.spec.ts). No actives
# SECRETS_BACKEND=vault en producción hasta tener un Vault/KMS real desplegado y sus
# credenciales.
# SECRETS_BACKEND=vault
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=
# VAULT_SECRET_PATH=atiende-hoteles/produccion
# VAULT_KV_MOUNT=secret
