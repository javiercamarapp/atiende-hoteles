# apps/api — variables de entorno (ver apps/api/src/env.ts). Copiar a `.env`
# (excluido de git) y ajustar. Ninguno de los valores de abajo es un secreto real.
#
# Rotación de secretos: ver docs/runbooks/operacion.md §6.

# development | test | production — en production, JWT_SECRET y
# CORS_ALLOWED_ORIGINS son obligatorios (sin default silencioso, REQ-SEG-013).
NODE_ENV=development

PORT=3001

# Firma de access/refresh tokens (jose/HS256). Generar con: openssl rand -base64 48
# Fuera de producción, si se omite, cae a un valor de desarrollo documentado como
# inseguro (nunca usarlo contra datos reales).
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Lista de orígenes permitidos por CORS, separados por coma. NUNCA "*"
# (auditoria-1/seguridad.md [MEDIO]). Fuera de producción, si se omite, cae a
# http://localhost:5173 (vite dev) y http://localhost:4173 (vite preview).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# embedded-postgres local (ADR-003) — no aplica a producción (Supabase). Déjalo SIN
# DEFINIR: apps/api/src/env.ts ya calcula un default absoluto anclado a la raíz del
# repo (packages/db/.pgdata), la MISMA carpeta que usan packages/db/src/cli.ts y
# scripts/backup.ts/restore.ts. auditoria-2/operabilidad [ALTO]: si defines aquí una
# ruta RELATIVA como "packages/db/.pgdata", vuelve a depender del cwd del proceso --
# con `npm run dev --workspace=@atiende-hoteles/api` (cwd real: apps/api/) escribiría
# en `apps/api/packages/db/.pgdata/`, fuera de `.gitignore` y de la vista de
# scripts/backup.sh (que resuelve la MISMA cadena relativa contra la raíz del repo, un
# directorio distinto). Si necesitas cambiar la ubicación, usa una ruta ABSOLUTA.
# DB_DATA_DIR=
DB_PORT=54329

# Rate limit (ipRateLimit/userRateLimit, apps/api/src/middleware.ts).
RATE_LIMIT_PER_IP_PER_MINUTE=300
RATE_LIMIT_PER_USER_PER_MINUTE=600

# Logging (apps/api/src/logger.ts). LOG_PRETTY=1 SOLO en desarrollo interactivo
# (nunca en producción: ahí siempre JSON por línea).
LOG_LEVEL=info
LOG_PRETTY=0

# Opcional: si se define, /metrics exige la cabecera X-Metrics-Token con este
# mismo valor (401 si falta/no coincide). Sin definir, /metrics queda abierto
# (pensado para exponerse solo dentro de la red del scraper de métricas).
METRICS_TOKEN=

# auditoria-2/operabilidad [ALTO]: destino de la alerta del camino del dinero
# (src/lib/moneyAlert.ts). Sin ninguna de las dos, la alerta queda SOLO como línea de
# log (el proceso lo declara al arrancar y GET /ready lo refleja en
# moneyAlertsConfigured: false).
# Webhook genérico (Slack Incoming Webhook, PagerDuty Events API, endpoint propio, o un
# relevo webhook->correo): recibe el JSON completo de la alerta por HTTP POST.
MONEY_ALERT_WEBHOOK_URL=
# Alternativa/adicional: requiere AMBAS variables. Envía {to, subject, alert} a
# MONEY_ALERT_EMAIL_WEBHOOK_URL -- este repo no trae ningún cliente SMTP/proveedor de
# correo propio (ADR-007, sin credenciales reales); MONEY_ALERT_EMAIL_WEBHOOK_URL debe
# apuntar a un relevo que sepa convertir ese payload en un correo real.
MONEY_ALERT_EMAIL_TO=
MONEY_ALERT_EMAIL_WEBHOOK_URL=

# Producción (Supabase, ADR-003) — no consumido todavía por apps/api/src/db.ts
# (que hoy solo arranca embedded-postgres local); declarado aquí para cuando
# exista el `db.ts` alterno de producción (ver docs/runbooks/despliegue.md §6).
# SUPABASE_DB_HOST=
# SUPABASE_DB_PASSWORD=

# REQ-SEG-013 (GOB-041) — provider de secretos, ver apps/api/src/lib/secretsProvider.ts.
# Opcional/opt-in: sin SECRETS_BACKEND (o con SECRETS_BACKEND=env), el arranque es
# EXACTAMENTE el de siempre -- lee las variables de arriba directo de process.env, 0
# llamadas de red. SECRETS_BACKEND=vault activa una capa REAL (protocolo HTTP genuino
# de HashiCorp Vault KV v2) que, ANTES de leer cualquier variable de arriba, lee un
# secreto de Vault y copia sus claves a process.env (sobrescribiendo cualquier valor
# plano ya definido). Fail-closed: si declaras SECRETS_BACKEND=vault y falta
# VAULT_ADDR/VAULT_TOKEN/VAULT_SECRET_PATH, o Vault no responde, el arranque FALLA --
# nunca sigue en silencio con las variables de entorno planas.
#
# ADVERTENCIA HONESTA: este repo nunca ha tenido una instancia de Vault/KMS
# desplegada ni credenciales de ese servicio -- este cliente implementa el protocolo
# real pero NUNCA se ha probado de extremo a extremo contra un Vault real (solo
# contra un `fetch` sustituido en tests/unit/api/secrets-provider.spec.ts). No actives
# SECRETS_BACKEND=vault en producción hasta tener un Vault/KMS real desplegado y sus
# credenciales.
# SECRETS_BACKEND=vault
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=
# VAULT_SECRET_PATH=atiende-hoteles/produccion
# VAULT_KV_MOUNT=secret
